<UserControl x:Class="WPF_APP.View.Teachers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WPF_APP.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="900"
             d:DesignWidth="933">

    <UserControl.DataContext>
        <vm:TeacherVM/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Border CornerRadius="0 20 20 0" Background="#fdf6fe">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBox x:Name="search"
                             Visibility="Visible"
                             VerticalAlignment="Center"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.LeadingIcon="Search"
                             materialDesign:HintAssist.Hint="Поиск"
                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                             materialDesign:HintAssist.FontFamily="Arial"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             Background="#ebddff"
                             BorderBrush="#e9def8"
                             Padding="5"
                             Margin="5,15"
                             Height="35"
                             Width="640"
                             Loaded="UserControl_Loaded"
                             TextChanged="search_TextChanged"/>
                </StackPanel>
                <DataGrid x:Name="userSchedualDataGrid"
                          Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding Teachers}"
                          SelectedItem="{Binding SelectedTeacher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Background="#ebddff"
                          BorderBrush="#e9def8"
                          AutoGenerateColumns="False"
                          Margin="0,10,0,10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фамилия"
                                            Binding="{Binding LastName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Имя"
                                            Binding="{Binding FirstName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Отчество"
                                            Binding="{Binding Surename}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Преподаваемые предметы"
                                            Binding="{Binding Subjects}" 
                                            Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5">
                    <Button x:Name="btnAdd"
                            Width="100"
                            Height="40"
                            Content="Добавить"
                            ToolTip="Добавить нового учителя"
                            FontFamily="Roboto Medium"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                              
                            Foreground="#fdf6fe"
                            Click="btnAdd_Click"
                            Margin="10"/>
                    <Button x:Name="btnEdit"
                            Width="100"
                            Height="40"
                            Content="Изменить"
                            ToolTip="Редактировать учителя"
                            FontFamily="Roboto Medium"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                              
                            Foreground="#fdf6fe"                                                                                                                              
                            Margin="10"/>
                    <Button x:Name="btnDelete"
                            Width="100"
                            Height="40"
                            Content="Удалить"
                            ToolTip="Удалить учителя"
                            FontFamily="Roboto Medium"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                              
                            Foreground="#fdf6fe"
                            Command="{Binding DeleteCommand}"
                            Margin="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>