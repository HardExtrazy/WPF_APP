<UserControl x:Class="WPF_APP.View.Subjects"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:WPF_APP.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="600"
             d:DesignWidth="622">
    <UserControl.DataContext>
        <vm:SubjectVM/>
    </UserControl.DataContext>
    <Grid Margin="15">
        <Border CornerRadius="0 20 20 0"
                Background="#fdf6fe">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height ="*"/>
                    <RowDefinition Height ="400"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBox x:Name="search"
                             VerticalAlignment="Center"
                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.LeadingIcon="Search"
                             materialDesign:HintAssist.Hint="Поиск"
                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                             materialDesign:HintAssist.FontFamily="Arial"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             Background="#ebddff"
                             BorderBrush="#e9def8"
                             Padding="5 5 5 5"
                             Margin="5 15"
                             Height="35"
                             Width="475"/>
                </StackPanel>
                <DataGrid x:Name="userSchedualDataGrid"
                          Grid.Row="1"
                          Background="#ebddff"
                          BorderBrush="#e9def8"
                          AutoGenerateColumns="False"
                          Margin="0,0,10,0"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Предмет"/>
                        <DataGridTextColumn Header="Классы"/>
                        <DataGridTextColumn Header="Недельная нагрузка"/>
                        <DataGridTextColumn Header="Коэфициент"/>
                        <DataGridTextColumn Header="Учитель"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5">
                    <Button x:Name="btnCreate"
                            Width="135"
                            Height="40"
                            Content="Редактировать"
                            ToolTip="Распределение учебных часов предметам"
                            FontFamily="Roboto Medium"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                              
                            Foreground="#fdf6fe"                                                                                                                              
                            Margin="10"/>
                    <Button x:Name="btnGenerate"
                            Width="135"
                            Height="40"
                            Content="Генерироваить"
                            ToolTip="Распределение учебных часов преподователям"
                            FontFamily="Roboto Medium"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                              
                            Foreground="#fdf6fe"                                                                                                                              
                            Margin="10"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
