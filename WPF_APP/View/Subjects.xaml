<UserControl x:Class="WPF_APP.View.Subjects"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:WPF_APP.ViewModel"
             Height="900"
             Width="933">

    <UserControl.DataContext>
        <vm:SubjectVM/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Border CornerRadius="0 20 20 0"
                Background="#fdf6fe">

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ПОЛЕ ПОИСКА -->
                <StackPanel Grid.Row="0">
                    <TextBox x:Name="search"
                             Visibility="Visible"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.LeadingIcon="Search"
                             materialDesign:HintAssist.Hint="Поиск по учителю, предмету или классу"
                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                             materialDesign:HintAssist.FontFamily="Arial"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             Background="#ebddff"
                             BorderBrush="#e9def8"
                             Padding="5"
                             Margin="5 15"
                             Height="35"
                             Width="640"
                             TextChanged="search_TextChanged"/>
                </StackPanel>

                <!-- ТАБЛИЦА С НАГРУЗКОЙ УЧИТЕЛЕЙ -->
                <DataGrid Grid.Row="1"
                          x:Name="teacherLoadDataGrid"
                          ItemsSource="{Binding TeacherLoads}"
                          Background="#ebddff"
                          BorderBrush="#e9def8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Margin="0,0,10,70"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#CCCCCC"
                          VerticalGridLinesBrush="#CCCCCC"
                          RowHeight="35"
                          >

                    <DataGrid.Columns>
                        <!-- Колонка "Класс" -->
                        <DataGridTextColumn Header="Класс" 
                                            Width="70"
                                            Binding="{Binding ClassName}"/>

                        <!-- Колонка "Учитель" -->
                        <DataGridTextColumn Header="Учитель"
                                            Width="*"
                                            Binding="{Binding TeacherName}"/>

                        <!-- Колонка "Предмет" -->
                        <DataGridTextColumn Header="Предмет" 
                                            Width="*"
                                            Binding="{Binding SubjectName}"/>

                        <!-- Колонка "Подгруппа" -->
                        <DataGridTextColumn Header="Подгруппа" 
                                            Width="100"
                                            Binding="{Binding Subgroup}"/>

                        <!-- Колонка "Недельная нагрузка" -->
                        <DataGridTextColumn Header="Нагрузка" 
                                            Width="90"
                                            Binding="{Binding WeeklyHours}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ОТЧЕТ -->
                <Border Grid.Row="1"
                        Background="#f8f9fa"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,500,10,10"
                        BorderBrush="#e9def8"
                        BorderThickness="1" Grid.RowSpan="2">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Информационное окно:"
                                   FontWeight="Bold"
                                   Margin="0 0 0 5"
                                   FontSize="12"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0 1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- КНОПКИ УПРАВЛЕНИЯ -->
                <StackPanel Grid.Row="3"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Margin="5">

                    <!-- Кнопка "Редактировать" -->
                    <Button x:Name="btnCreate"
            Click="btnCreate_Click"
            Width="135"
            Height="40"
            Content="Редактировать"
            ToolTip="Редактирование учебных часов"
            FontFamily="Roboto Medium"
            Style="{StaticResource MaterialDesignRaisedButton}"
            materialDesign:ButtonAssist.CornerRadius="15"
            Margin="10"/>

                    <!-- Кнопка "Генерировать всё" (заменяет старую кнопку) -->
                    <Button x:Name="btnGenerateAll"
            Width="135"
            Height="40"
            Content="Генерировать"
            ToolTip="Распределение нагрузки между всеми учителями"
            FontFamily="Roboto Medium"
            Style="{StaticResource MaterialDesignRaisedButton}"
            materialDesign:ButtonAssist.CornerRadius="15"
            Margin="10"
            Click="btnGenerateAll_Click"/>

                    <!-- Кнопка "Обновить" -->
                    <Button x:Name="btnRefresh"
            Width="100"
            Height="40"
            Content="Обновить"
            ToolTip="Обновить данные"
            FontFamily="Roboto Medium"
            Style="{StaticResource MaterialDesignRaisedButton}"
            materialDesign:ButtonAssist.CornerRadius="15"
            Margin="10"
            Click="btnRefresh_Click"/>

                    <!-- Кнопка "Очистить лог" -->
                    <Button x:Name="btnClearLog"
            Width="100"
            Height="40"
            Content="Очистить"
            ToolTip="Очистить информационное окно от сообщений"
            FontFamily="Roboto Medium"
            Style="{StaticResource MaterialDesignRaisedButton}"
            materialDesign:ButtonAssist.CornerRadius="15"
            Margin="10"
            Click="btnClearLog_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>