<Window x:Class="WPF_APP.AddClass"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        xmlns:vm="clr-namespace:WPF_APP.ViewModel"
        mc:Ignorable="d"
        Title="Добавление класса" 
        Height="450" Width="450" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:AddClassVM />
    </Window.DataContext>

    <Border CornerRadius="20"
            BorderThickness="1"
            Background="#c9c2cd"
            Margin="10">
        <Grid>
            <Border CornerRadius="20"
                    BorderThickness="1"
                    Background="#fdf6fe"
                    Margin="10">
                <StackPanel Margin="25,25,25,10">

                    <TextBlock Text="Добавить класс"
                               FontFamily="Segoe Print"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 15"/>

                    <!-- Номер и буква класса -->
                    <StackPanel Orientation="Horizontal" Width="300" HorizontalAlignment="Center">

                        <!-- Номер класса -->
                        <ComboBox ItemsSource="{Binding ClassNumbers}"
                                  SelectedItem="{Binding SelectedNumber}"
                                  DisplayMemberPath="Name"
                                  Width="135"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:TextFieldAssist.LeadingIcon="Number0Box"
                                  materialDesign:HintAssist.Hint="Номер *"
                                  materialDesign:HintAssist.FontFamily="Arial"
                                  materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                  Background="#ebddff"
                                  BorderBrush="#e9def8"
                                  Padding="5 5 5 5"
                                  Margin="10 5 0 10"/>

                        <!-- Буква класса -->
                        <ComboBox ItemsSource="{Binding ClassLetters}"
                                  SelectedItem="{Binding SelectedLetter}"
                                  DisplayMemberPath="Name"
                                  Width="135"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:TextFieldAssist.LeadingIcon="LetterABox"
                                  materialDesign:HintAssist.Hint="Буква *"
                                  materialDesign:HintAssist.FontFamily="Arial"
                                  materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                  Background="#ebddff"
                                  BorderBrush="#e9def8"
                                  Padding="5 5 5 5"
                                  Margin="10 5 0 10"/>
                    </StackPanel>

                    <!-- Классный руководитель -->
                    <StackPanel Orientation="Horizontal" Width="300" HorizontalAlignment="Center">
                        <ComboBox ItemsSource="{Binding AvailableMentors}"
                                  SelectedItem="{Binding SelectedMentor}"
                                  DisplayMemberPath="FullName"
                                  Width="280"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:TextFieldAssist.LeadingIcon="HatFedora"
                                  materialDesign:HintAssist.Hint="Классный руководитель"
                                  materialDesign:HintAssist.FontFamily="Arial"
                                  materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                  Background="#ebddff"
                                  BorderBrush="#e9def8"
                                  Padding="5 5 5 5"
                                  Margin="10 5 0 10"
                                  IsEnabled="{Binding SelectedNumber}"/>
                    </StackPanel>

                    <!-- Смена -->
                    <StackPanel Orientation="Horizontal" Width="300" HorizontalAlignment="Center">
                        <CheckBox Content="Первая смена?"
                                  IsChecked="{Binding IsFirstShift}"
                                  Width="280"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  materialDesign:HintAssist.FontFamily="Arial"
                                  Background="#ebddff"
                                  Margin="10 5 0 10"/>
                    </StackPanel>

                    <!-- Нагрузка -->
                    <StackPanel Orientation="Horizontal" Width="300" HorizontalAlignment="Center">
                        <TextBox Text="{Binding WorkLoad, Mode=OneWay}"
                                 Width="280"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:TextFieldAssist.LeadingIcon="Clock"
                                 materialDesign:HintAssist.Hint="Максимальная нагрузка"
                                 materialDesign:HintAssist.FontFamily="Arial"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 Background="#ebddff"
                                 BorderBrush="#e9def8"
                                 Padding="5 5 5 5"
                                 Margin="10 5 0 10"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0 20 0 10">

                        <!-- Кнопка "Назад" -->
                        <Button Width="100"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                ToolTip="Вернуться назад"
                                Command="{Binding CloseCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Назад"
                                FontFamily="Roboto Medium"
                                Margin="5"/>

                        <!-- Кнопка "Создать" -->
                        <Button Width="100"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                ToolTip="Создать класс"
                                Command="{Binding CreateClassCommand}"
                                Content="Создать"
                                FontFamily="Roboto Medium"
                                IsEnabled="{Binding IsCreateButtonEnabled}"
                                Margin="5"/>
                    </StackPanel>

                    <!-- Информация об обязательных полях -->
                    <TextBlock Text="* Обязательные поля"
                               FontSize="10"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0 5 0 10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>