<Window x:Class="WPF_APP.LessonHours"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPF_APP.ViewModel"
        xmlns:utils="clr-namespace:WPF_APP.Utilities"
        Title="Учебные часы" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:LessonHoursVM/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Конвертер для цвета в зависимости от суммы -->
        <utils:HoursToColorConverter x:Key="HoursToColorConverter"/>
    </Window.Resources>

    <Border CornerRadius="20"
            BorderThickness="1"
            Background="#c9c2cd"
            Margin="10">
        <Border CornerRadius="20"
                BorderThickness="1"
                Background="#fdf6fe"
                Margin="10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <!-- Информация о загрузке -->
                <TextBlock Grid.Row="0" 
                           Text="{Binding SubjectHours.Count, StringFormat='Всего предметов: {0}'}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="5"/>
                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SubjectHours}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="All"
                          RowHeight="35"
                          Background="#ebddff"
                          CellEditEnding="DataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <!-- Колонка с названием предмета -->
                        <DataGridTextColumn Header="Предмет / Классы" 
                                            Width="200"
                                            Binding="{Binding SubjectName}"
                                            IsReadOnly="True"/>
                        <!-- Колонки для часов-->
                        <DataGridTextColumn Header="1 класс"
                                            Width="*"
                                            Binding="{Binding Class1Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="2 класс"
                                            Width="*"
                                            Binding="{Binding Class2Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="3 класс"
                                            Width="*" Binding="{Binding Class3Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="4 класс"
                                            Width="*"
                                            Binding="{Binding Class4Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="5 класс"
                                            Width="*"
                                            Binding="{Binding Class5Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="6 класс"
                                            Width="*"
                                            Binding="{Binding Class6Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="7 класс"
                                            Width="*"
                                            Binding="{Binding Class7Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="8 класс"
                                            Width="*"
                                            Binding="{Binding Class8Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="9 класс"
                                            Width="*"
                                            Binding="{Binding Class9Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="10 класс"
                                            Width="*"
                                            Binding="{Binding Class10Hours, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="11 класс"
                                            Width="*"
                                            Binding="{Binding Class11Hours, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Панель с суммами по классам -->
                <Border Grid.Row="2" 
                        Background="#ebddff" 
                        CornerRadius="10" 
                        Padding="10" 
                        Margin="0 10 0 10">
                    <StackPanel>
                        <TextBlock Text="Сумма часов по классам:" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Margin="0 0 0 10"/>

                        <WrapPanel HorizontalAlignment="Center">
                            <!-- 1 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="1 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[1], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[1], Converter={StaticResource HoursToColorConverter}, ConverterParameter=1}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 2 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="2 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[2], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[2], Converter={StaticResource HoursToColorConverter}, ConverterParameter=2}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 3 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="3 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[3], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[3], Converter={StaticResource HoursToColorConverter}, ConverterParameter=3}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 4 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="4 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[4], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[4], Converter={StaticResource HoursToColorConverter}, ConverterParameter=4}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 5 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="5 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[5], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[5], Converter={StaticResource HoursToColorConverter}, ConverterParameter=5}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 6 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="6 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[6], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[6], Converter={StaticResource HoursToColorConverter}, ConverterParameter=6}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 7 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="7 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[7], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[7], Converter={StaticResource HoursToColorConverter}, ConverterParameter=7}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 8 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="8 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[8], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[8], Converter={StaticResource HoursToColorConverter}, ConverterParameter=8}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 9 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="9 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[9], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[9], Converter={StaticResource HoursToColorConverter}, ConverterParameter=9}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 10 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10 кл:"
                                               FontWeight="Bold"
                                               Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding TotalHours[10], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[10], Converter={StaticResource HoursToColorConverter}, ConverterParameter=10}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- 11 класс -->
                            <Border BorderBrush="#9370DB"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="3"
                                    Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="11 кл:"
                                               FontWeight="Bold"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding TotalHours[11], StringFormat={} {0} ч}" 
                                               Foreground="{Binding TotalHours[11], Converter={StaticResource HoursToColorConverter}, ConverterParameter=11}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- Кнопки -->
                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnSave"                   
                            Width="105"
                            Height="40"
                            Margin="0 0 25 0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                                   
                            Foreground="#fdf6fe"
                            ToolTip="Сохранить изменения"
                            Content="Сохранить"
                            FontFamily="Roboto Medium"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnClose"                   
                            Width="105"
                            Height="40"
                            Margin="0 0 0 0"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="15"                                   
                            Foreground="#fdf6fe"
                            ToolTip="Закрыть окно"
                            Content="Закрыть"
                            FontFamily="Roboto Medium"
                            Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>