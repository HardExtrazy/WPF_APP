<Window x:Class="WPF_APP.RecoverAccount"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        mc:Ignorable="d"
        Title="RecoverAccount" Height="450" Width="450"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize">
    <!--Внешняя граница-->
    <Border CornerRadius="20"
            BorderThickness="1"
            Background="#c9c2cd"
            Margin="10">
        <Grid>
            <!--Внутреннее окно-->
            <Border CornerRadius="20"
                    BorderThickness="1"
                    Background="#fdf6fe"
                    Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Grid.Row="0"
                                Margin="0 10 10 5">
                        <!--Кнопка "Закрыть окно"-->
                        <Button x:Name ="Exit"
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="#ebddff"
                                ToolTip="Закрыть"
                                Click="btnExit_Click"
                                BorderBrush="#e9def8"
                                Cursor="Hand"
                                Width="25"
                                Height="25">
                            <materialDesign:PackIcon Kind="Close"
                                                     Foreground="#4f3d74"
                                                     Width="15"
                                                     Height="15"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="Восстановление аккаунта"
                                   TextAlignment="Center"
                                   FontSize="22"
                                   FontFamily="Segoe Print"/>
                    </StackPanel>
                    <TabControl x:Name="recoverAccount"                                
                                Grid.Row="1">
                        <!--Поиск электронной почты-->
                        <TabItem x:Name="searchEmail"
                                 Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center">
                                <Border  CornerRadius="20"                                        
                                         BorderThickness="1"
                                         Background="#ffdad6"
                                         Width="350"
                                         Height="50"
                                         Margin="10">
                                    <!--Подсказка-->
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Bulb"
                                                                 VerticalAlignment="Center"
                                                                 Height="25"
                                                                 Width="25"
                                                                 Foreground="#93000a"
                                                                 Margin="10 0 0 0"/>
                                        <TextBlock Text="Чтобы найти свой аккаунт, введите ваш электронной почты."
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Arial"
                                                   Foreground="#93000a"
                                                   Margin="5 0 0 0"
                                                   Width="300"/>
                                    </StackPanel>
                                </Border>
                                <!--Поле ввода почты-->
                                <StackPanel Margin="0 10">
                                    <TextBox x:Name="email"
                                             Width="250"
                                             Height="40"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Mailbox"
                                             materialDesign:HintAssist.Hint="Электронная почта"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"                                   
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Margin="0 120">
                                    <!--Кнопка "Назад"-->
                                    <Button x:Name="btnBack_1"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            Foreground="#fdf6fe" 
                                            ToolTip="Закрыть окно"
                                            Click="btnBack_1_Click"
                                            Content="Назад"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                    <!--Кнопка "Поиск"-->
                                    <Button x:Name="btnSearch"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Foreground="#fdf6fe" 
                                            materialDesign:ButtonAssist.CornerRadius="15"                                            
                                            ToolTip="Поиск аккаунта"
                                            Click="btnSearch_Click"
                                            Content="Поиск"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <!--Ввод кода востановления пароля-->
                        <TabItem x:Name="enterCode"
                                 Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center">
                                <Border  CornerRadius="20"                                        
                                         BorderThickness="1"
                                         Background="#ffdad6"
                                         Width="350"
                                         Height="50"
                                         Margin="10">
                                    <!--Подсказка-->
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Bulb"
                                                                 VerticalAlignment="Center"
                                                                 Height="25"
                                                                 Width="25"
                                                                 Foreground="#93000a"
                                                                 Margin="10 0 0 0"/>
                                        <TextBlock Text="Мы отправили код восстановления на ваш email. Пожалуйста, проверьте папку &quot;Входящие&quot; или &quot;Спам&quot;."
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Arial"
                                                   Foreground="#93000a"
                                                   Margin="5 0 0 0"
                                                   Width="300"/>
                                    </StackPanel>
                                </Border>
                                <!--Поле ввода кода востановления-->
                                <StackPanel Margin="0 10">
                                    <TextBox x:Name="code"
                                             Width="250"
                                             Height="40"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Key"
                                             materialDesign:HintAssist.Hint="Код восстановления"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"                                   
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Margin="0 120">
                                    <!--Кнопка "Назад"-->
                                    <Button x:Name="btnBack_2"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            Foreground="#fdf6fe" 
                                            ToolTip="Вернуться к поиску электронной почты"
                                            Click="btnBack_2_Click"
                                            Content="Назад"
                                            FontFamily="Roboto Medium"
                                            Margin="10" Cursor="Hand"/>
                                    <!--Кнопка "Далее"-->
                                    <Button x:Name="btnNext"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Foreground="#fdf6fe" 
                                            materialDesign:ButtonAssist.CornerRadius="15"                                            
                                            ToolTip="Продолжить процедуру восстановления пароля"
                                            Click="btnNext_Click"
                                            Content="Далее"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                        <!--Ввод нового пароля-->
                        <TabItem x:Name="enterNewPassword"
                                 Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center">
                                <Border  CornerRadius="20"                                        
                                         BorderThickness="1"
                                         Background="#ffdad6"
                                         Width="350"
                                         Height="50"
                                         Margin="10">
                                    <!--Подсказка-->
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Bulb"
                                         VerticalAlignment="Center"
                                         Height="25"
                                         Width="25"
                                         Foreground="#93000a"
                                         Margin="10 0 0 0"/>
                                        <TextBlock Text="Введите новый пароль для вашего аккаунта"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Arial"
                                                   Foreground="#93000a"
                                                   Margin="5 0 0 0"
                                                   Width="300"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin=" 0 10 0 0"
                                            Width="300">
                                    <!--Поле ввода нового пароля-->
                                    <PasswordBox x:Name="password"
                                                 Width="250"
                                                 Height="40"
                                                 Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="PasswordAdd"
                                                 materialDesign:HintAssist.Hint="Новый пароль"   
                                                 materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                                 materialDesign:HintAssist.FontFamily="Arial"                           
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                                 Background="#ebddff"
                                                 BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                                 Padding="5 5 5 5"
                                                 Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Повторный ввод нового пароля-->
                                <StackPanel Width="300">
                                    <PasswordBox x:Name="repiatPassword"
                                                 Width="250"
                                                 Height="40"
                                                 Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="PasswordAddOutline"
                                                 materialDesign:HintAssist.Hint="Повторите новый пароль"
                                                 materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                                 materialDesign:HintAssist.FontFamily="Arial"                           
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                                 Background="#ebddff"
                                                 BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                                 Padding="5 5 5 5"
                                                 Margin="20 5 0 10"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Margin="0 75">
                                    <!--Кнопка "Назад"-->
                                    <Button x:Name="btnBack_3"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            Foreground="#fdf6fe" 
                                            ToolTip="Вернуться к поиску электронной почты"
                                            Click="btnBack_3_Click"
                                            Content="Назад"
                                            FontFamily="Roboto Medium"
                                            Margin="10" Cursor="Hand"/>
                                    <!--Кнопка "Далее"-->
                                    <Button x:Name="btnChange"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Foreground="#fdf6fe" 
                                            materialDesign:ButtonAssist.CornerRadius="15"                                            
                                            ToolTip="Закончить процедуру восстановления пароля"
                                            Click="btnChange_Click"
                                            Content="Далее"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        
    </Border>
    
</Window>
    
