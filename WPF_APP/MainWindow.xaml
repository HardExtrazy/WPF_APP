<Window x:Class="WPF_APP.MainWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize">
    <!--Стиль для гипессылки-->
    <Window.Resources>
        <Style x:Key="CustomHyperlink"
               TargetType="Hyperlink">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="TextDecorations"
                    Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="TextDecorations"
                            Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!--Внешняя граница-->
    <Border  CornerRadius="20"
             BorderThickness="1"
             Background="#c9c2cd"
             Margin="10">
        <Grid>
            <!--Внутреннее окно-->
            <Border CornerRadius="20"
                    BorderThickness="1"
                    Background="#fdf6fe"
                    Margin="10">
                <StackPanel Orientation="Horizontal">
                    <!--Изображение-->
                    <StackPanel Width="350"
                                HorizontalAlignment="Left">
                        <Image Source="Img/LogIn.png"
                               Height="402"/>
                    </StackPanel>
                    <StackPanel Width="407"
                                Margin="10 0"
                                Height="406">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="20 5">
                            <!--Кнопка "Свернуть окно"-->
                            <Button x:Name ="Minimize"
                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                    Background="#ebddff"
                                    ToolTip="Свернуть"
                                    Click="btnMinimize_Click"
                                    BorderBrush="#e9def8"
                                    Cursor="Hand"
                                    Width="25"
                                    Height="25"
                                    Margin="0 0 5 0">
                                <materialDesign:PackIcon Kind="Minimize"
                                                         Foreground="#4f3d74"
                                                         Width="15"
                                                         Height="15"/>
                            </Button>
                            <!--Кнопка "Закрыть программу"-->
                            <Button x:Name ="Exit"
                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                    Background="#ebddff"
                                    ToolTip="Закрыть"
                                    Click="btnExit_Click"
                                    BorderBrush="#e9def8"
                                    Cursor="Hand"
                                    Width="25"
                                    Height="25">
                                <materialDesign:PackIcon Kind="Close"
                                                         Foreground="#4f3d74"
                                                         Width="15"
                                                         Height="15"/>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Вход пользователя"                                       
                                       TextAlignment="Center"
                                       FontSize="28"
                                       FontFamily="Segoe Print"
                                       Margin="0 35"/>
                        </StackPanel>
                        <!--Панель ввода логина-->
                        <StackPanel Orientation="Horizontal"
                                    Margin="-10"
                                    Width="200">
                            <materialDesign:PackIcon Kind="User"
                                                     Width="30"
                                                     Height="30"/>
                            <TextBox x:Name="txtUsername"
                                     Margin="10 0"
                                     Width="160"
                                     materialDesign:HintAssist.Hint="Введите имя пользователя"
                                     Style="{StaticResource MaterialDesignTextBox}"                                    
                                     Cursor="Pen"/>
                        </StackPanel>
                        <!--Панель ввода пароля-->
                        <StackPanel Orientation="Horizontal"
                                    Margin="20"
                                    Width="200">
                            <materialDesign:PackIcon Kind="Password"
                                                     Width="30"
                                                     Height="30"/>
                            <PasswordBox x:Name="txtPassword"
                                         Margin="10 0"
                                         Width="160"
                                         materialDesign:HintAssist.Hint="Введите пароль"
                                         Style="{StaticResource MaterialDesignRevealPasswordBox}"                                        
                                         Cursor="Pen"/>
                        </StackPanel>
                        <!--Панель запоминания пароля-->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="10 -5 0 0">
                            <CheckBox x:Name="checkBoxSaveUser"
                                      Content="Запомнить меня"
                                      FontFamily="Roboto Medium"                                      
                                      ToolTip="Выберите, чтобы сохранить данные аккаунта для быстрого входа на этом устройстве"
                                      Width="210"
                                      Height="20"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="10">
                            <!--Кнопка "Войти"-->
                            <Button x:Name="btnLogin"
                                    Width="100"
                                    Height="40"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="15"                                   
                                    Foreground="#fdf6fe"
                                    ToolTip="Войдите в свой аккаунт"
                                    Click="btnLogIn_Click"
                                    Content="Войти"
                                    FontFamily="Roboto Medium">
                            </Button>
                            <!--Кнопка "Создать учетную запись"-->
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="10">
                                <Hyperlink x:Name="Registration"
                                           Foreground="#4f3d74"
                                           Cursor="Hand"
                                           Click="hpRegistration_Click"
                                           Style="{StaticResource CustomHyperlink}">
                                    <TextBlock Text="Создать учетную запись"
                                               FontFamily="Roboto Medium"/>
                                </Hyperlink>
                            </TextBlock>
                            <!--Кнопка "Забыли пароль"-->
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="-5">
                              <Hyperlink x:Name="CantLogIn"
                                         Foreground="#4f3d74"
                                         Cursor="Hand"
                                         Click="hpCantLogIn_Click"
                                         Style="{StaticResource CustomHyperlink}">
                                <TextBlock Text="Забыли пароль?"
                                           FontFamily="Roboto Medium"/>
                              </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--Нижняя надпись-->
            <TextBlock Text="ГУО &quot;Средняя школа №12 г. Борисова&quot;"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="20"
                       FontFamily="Roboto Medium"
                       FontSize="14"/>
        </Grid>
    </Border>
</Window>
