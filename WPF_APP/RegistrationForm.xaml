<Window x:Class="WPF_APP.RegistrationForm"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        xmlns:vm="clr-namespace:WPF_APP.ViewModel"
        mc:Ignorable="d"
        Title="RegistrationForm" Height="550" Width="500" MinHeight="450" MinWidth="350"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize"
        xmlns:converters="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
        xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf">
    <Window.DataContext>
        <vm:RegistrationVM/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="449*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Внешняя граница-->
        <Border CornerRadius="20"
                BorderThickness="1"
                Background="#c9c2cd"
                Margin="10">
            <!--Внутреннее окно-->
            <Border CornerRadius="20"
                    BorderThickness="1"
                    Background="#fdf6fe"
                    Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="370,0,0,0"
                                Width="48">
                        <!--Кнопка "Закрыть окно"-->
                        <Button x:Name ="Exit"                               
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="#ebddff"                               
                                ToolTip="Закрыть"
                                Click="btnExit_Click"
                                BorderBrush="#e9def8"
                                Cursor="Hand"
                                Width="25"
                                Height="25"
                                Margin="10 0 10 10">
                            <materialDesign:PackIcon Kind="Close"
                                                     Foreground="#4f3d74"
                                                     Width="15"
                                                     Height="15"/>
                        </Button>
                    </StackPanel>
                    <Label Grid.Row="1"
                           Grid.Column="1"                       
                           Content="ОКНО РЕГИСТРАЦИИ"
                           FontFamily="Segoe Print"
                           FontSize="15"
                           Padding="0"                          
                           HorizontalAlignment="Center"
                           Margin="0,10,0,320"/>
                    <TabControl x:Name="registrarion"
                                HorizontalAlignment="Center"
                                Grid.Row="1"                               
                                LayoutTransform="1.2 0 0 1.2 0 0"
                                Grid.Column="1"
                                Margin="0,0,0,-5">
                        <!--Панель первого этапа регистрации-->
                        <TabItem x:Name="stepOne"
                                 Visibility="Collapsed">
                            <StackPanel Margin="35">
                                <TextBlock Text="Шаг 1"
                                           FontFamily="Segoe Print"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <!--Ввод имени пользователя-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="login"
                                             Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                             Width="215"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="User"                                    
                                             materialDesign:HintAssist.Hint="Имя пользователя"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"                                             
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Ввод электронной почты-->
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <TextBox x:Name="email"
                                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Width="215" 
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Mailbox"
                                             materialDesign:HintAssist.Hint="Электронная почта"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"                                   
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Ввод пароля-->
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <PasswordBox x:Name="password"
                                                 PasswordChanged="PasswordBox_PasswordChanged"
                                                 Width="215"
                                                 Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="PasswordAdd"
                                                 materialDesign:HintAssist.Hint="Пароль"   
                                                 materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                                 materialDesign:HintAssist.FontFamily="Arial"                           
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                                 Background="#ebddff"
                                                 BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                                 Padding="5 5 5 5"
                                                 Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Повторный ввод пароля-->
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <PasswordBox x:Name="repeatPassword"
                                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                                 Width="215"
                                                 Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="PasswordAddOutline"
                                                 materialDesign:HintAssist.Hint="Повторите пароль"
                                                 materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                                 materialDesign:HintAssist.FontFamily="Arial"                           
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                                 Background="#ebddff"
                                                 BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                                 Padding="5 5 5 5"
                                                 Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Ввод номера телефона-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <ComboBox x:Name="codePhone"
                                              SelectedValue="{Binding CountryCode}"
                                              SelectedValuePath="Content"
                                              Width="50"
                                              Height="32"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                              materialDesign:HintAssist.FontFamily="Arial"
                                              materialDesign:TextFieldAssist.TextBoxViewMargin="8 0 0 0"
                                              Background="#ebddff"
                                              BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                              Padding="5 5 5 5"
                                              Margin="20 5 0 10" >
                                        <ComboBoxItem x:Name="firstCode"
                                                      Content="29"
                                                      FontFamily="Arial"/>
                                        <ComboBoxItem x:Name="secondCode"
                                                      Content="44"
                                                      FontFamily="Arial"/>
                                        <ComboBoxItem x:Name="thirdCode"
                                                      Content="33"
                                                      FontFamily="Arial"/>
                                        <ComboBoxItem x:Name="fourthCode"
                                                      Content="25"
                                                      FontFamily="Arial"/>
                                    </ComboBox>
                                    <TextBox x:Name="phoneNumber"
                                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160"
                                             MaxLength="7"                                             
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                             materialDesign:HintAssist.Hint="Номер телефона"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"                           
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="5 5 0 10"/>
                                </StackPanel>
                                <!--Кнопка "Далее"-->
                                <Button x:Name="btnNext"
                                        IsEnabled="{Binding CanGoToNextStep}"
                                        Width="100"
                                        Height="40"
                                        Content="Далее"
                                        ToolTip="Продолжить регистрацию"
                                        FontFamily="Roboto Medium"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="15"                              
                                        Foreground="#fdf6fe"                                                                                                  
                                        Click="btnNext_Click"                              
                                        Margin="10"/>
                            </StackPanel>
                        </TabItem>
                        <!--Панель второго этапа регистрации-->
                        <TabItem x:Name="stepTwo"
                                 Visibility="Collapsed">
                            <StackPanel Margin="35">
                                <TextBlock Text="Шаг 2"
                                           FontFamily="Segoe Print"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <!--Ввод имени-->
                                    <TextBox x:Name="firstName"
                                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="215"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="AccountBadge"
                                             materialDesign:HintAssist.Hint="Имя"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"                           
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Ввод фамилии-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="lastName"
                                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                             Width="215"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="AccountDownload"
                                             materialDesign:HintAssist.Hint="Фамилия"
                                             materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                             materialDesign:HintAssist.FontFamily="Arial"                           
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             Background="#ebddff"
                                             BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Выбор даты рождения-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <Border Background="#ebddff"
                                            BorderBrush="#e9def8"                                            
                                            CornerRadius="4"
                                            Margin="20 5 0 10">
                                        <DatePicker x:Name="dateOfBirth"
                                                    SelectedDate="{Binding DateOfBirth}"
                                                    Width="215"
                                                    Language="ru-RU"
                                                    Style = "{StaticResource MaterialDesignOutlinedDatePicker}"
                                                    materialDesign:TextFieldAssist.LeadingIcon="DateRange"
                                                    materialDesign:HintAssist.Hint="Дата рождения"
                                                    materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                                    materialDesign:HintAssist.FontFamily="Arial"                           
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"                                            
                                                    BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                         
                                                    Padding="5 5 5 5">
                                        </DatePicker>
                                    </Border>
                                </StackPanel>
                                <!--Выбор обраpования-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <ComboBox x:Name="education"
                                               ItemsSource="{Binding Educations}"
                                               DisplayMemberPath="Name"
                                               SelectedValuePath="Id"
                                               SelectedValue="{Binding SelectedEducationId}"
                                               Width="215"
                                               Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                               materialDesign:TextFieldAssist.LeadingIcon="Book"
                                               materialDesign:HintAssist.Hint="Образование"
                                               materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                               materialDesign:HintAssist.FontFamily="Arial"                           
                                               materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                               Background="#ebddff"
                                               BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                               Padding="5 5 5 5"
                                               Margin="20 5 0 10"/>
                                </StackPanel>
                                <!--Выбор должности-->
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <ComboBox x:Name="role"
                                              ItemsSource="{Binding Roles}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                             SelectedValue="{Binding SelectedRoleId}"
                                              Width="215"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:TextFieldAssist.LeadingIcon="HatFedora"
                                              materialDesign:HintAssist.Hint="Должность"
                                              materialDesign:HintAssist.HintPaddingBrush="#fdf6fe"
                                              materialDesign:HintAssist.FontFamily="Arial"                           
                                              materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                              Background="#ebddff"
                                              BorderBrush="#e9def8"                                                                                                                                                                                                                                                                                          
                                              Padding="5 5 5 5"
                                              Margin="20 5 0 10"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!--Кнопка "Назад"-->
                                    <Button x:Name="btnBack"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            materialDesign:ButtonAssist.CornerRadius="15"
                                            Foreground="#fdf6fe" 
                                            ToolTip="Вернуться к шагу 1"
                                            Click="btnBack_Click"
                                            Content="Назад"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                    <!--Кнопка "Создать"-->
                                    <Button x:Name="btnCreate"
                                            IsEnabled="{Binding CanRegister}"
                                            Command="{Binding RegisterCommand}"
                                            Width="100"
                                            Height="40"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Foreground="#fdf6fe" 
                                            materialDesign:ButtonAssist.CornerRadius="15"                                            
                                            ToolTip="Создать аккаунт"
                                            Content="Создать"
                                            FontFamily="Roboto Medium"
                                            Margin="10"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
