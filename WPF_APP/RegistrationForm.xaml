<Window x:Class="WPF_APP.RegistrationForm"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_APP"
        mc:Ignorable="d"
        Title="RegistrationForm" Height="450" Width="400" MinHeight="450" MinWidth="350"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="449*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="20"
                BorderThickness="1"
                Background="#b4b6b5"
                Margin="10">
            <Border CornerRadius="20"
                    BorderThickness="1"
                    Background="#eaf0f3"
                    Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Grid.Column="2">
                        <Button x:Name ="Exit"
                                Style="{StaticResource MaterialDesignFloatingActionButton}"
                                Background="#1d7d97"
                                Foreground="#16596b"
                                ToolTip="Закрыть"
                                Click="btnExit_Click"
                                BorderBrush="#16596b"
                                Cursor="Hand" Width="25"
                                Height="25"
                                Margin="10 0 10 10">
                            <materialDesign:PackIcon Kind="Close"
                                                     Foreground="#eaf0f3"
                                                     Width="15" Height="15"/>
                        </Button>
                    </StackPanel>
                    <Label Grid.Row="1"
                           Grid.Column="1"                       
                           Content="ОКНО РЕГИСТРАЦИИ"
                           FontFamily="Segoe Print"
                           FontSize="15"
                           Padding="0"
                           Foreground="{StaticResource MaterialDesignShadowBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,320"/>
                    <TabControl Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,0,0,-30">
                        <TabItem Visibility="Collapsed">
                            <StackPanel Margin="35">
                                <TextBlock Text="Шаг 1"
                                           FontFamily="Segoe Print"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <TextBox x:Name="login"
                                     Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.LeadingIcon="User"
                                     materialDesign:HintAssist.Hint="Имя пользователя"
                                     materialDesign:HintAssist.Foreground="Black"
                                     materialDesign:HintAssist.FontFamily="Arial"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                     CaretBrush="Black"
                                     SelectionBrush="Black"
                                     Padding="5 5 5 5"
                                     Margin="20 5 0 10"                            
                                     Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationLoginIcon"
                                                     Visibility="Hidden"
                                                     Width="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <TextBox x:Name="email"
                                     Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.LeadingIcon="Mailbox"
                                     materialDesign:HintAssist.Hint="Электронная почта"
                                     materialDesign:HintAssist.Foreground="Black"
                                     materialDesign:HintAssist.FontFamily="Arial"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                     CaretBrush="Black"
                                     SelectionBrush="Black"
                                     Padding="5 5 5 5"
                                     Margin="20 5 0 10"                            
                                     Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationEmailIcon"
                                                     Visibility="Hidden"
                                                     Width="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <PasswordBox x:Name="password"
                                         Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                         materialDesign:TextFieldAssist.LeadingIcon="PasswordAdd"
                                         materialDesign:HintAssist.Hint="Пароль"
                                         materialDesign:HintAssist.Foreground="Black"
                                         materialDesign:HintAssist.FontFamily="Arial"
                                         materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                         CaretBrush="Black"
                                         SelectionBrush="Black"
                                         Padding="5 5 5 5"
                                         Margin="20 5 0 10"                            
                                         Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationPasswordIcon"
                                                     Visibility="Hidden"
                                                     Width="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                    Width="250">
                                    <PasswordBox x:Name="repiatPassword"
                                         Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                         materialDesign:TextFieldAssist.LeadingIcon="PasswordAddOutline"
                                         materialDesign:HintAssist.Hint="Повторите пароль"
                                         materialDesign:HintAssist.Foreground="Black"
                                         materialDesign:HintAssist.FontFamily="Arial"
                                         materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                         CaretBrush="Black"
                                         SelectionBrush="Black"
                                         Padding="5 5 5 5"
                                         Margin="20 5 0 10"                            
                                         Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationRepiatPasswordIcon"
                                                     Visibility="Hidden"
                                                     Width="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="phoneNumber"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                             materialDesign:HintAssist.Hint="Номер телефона"
                                             materialDesign:HintAssist.Foreground="Black"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             CaretBrush="Black"
                                             SelectionBrush="Black"
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"                            
                                             Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationPhoneNumberIcon"
                                                             Visibility="Hidden"
                                                             Width="15"
                                                             VerticalAlignment="Center"
                                                             Margin="0 0 0 5"/>
                                </StackPanel>
                                <Button x:Name="btnNext"
                                Width="100"
                                Height="40"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                BorderThickness="2"
                                BorderBrush="#16596b"
                                Background="#1d7d97"
                                Foreground="#eaf0f3"
                                ToolTip="Продолжить регистрацию"
                                Click="btnNext_Click"
                                Content="Далее"
                                FontFamily="Roboto Medium"
                                Margin="10"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Visibility="Collapsed">
                            <StackPanel Margin="35">
                                <TextBlock Text="Шаг 2"
                                           FontFamily="Segoe Print"
                                           FontSize="14"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="firstName"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="AccountBadge"
                                             materialDesign:HintAssist.Hint="Имя"
                                             materialDesign:HintAssist.Foreground="Black"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             CaretBrush="Black"
                                             SelectionBrush="Black"
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"                            
                                             Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationFirstNameIcon"
                                                             Visibility="Hidden"
                                                             Width="15"
                                                             VerticalAlignment="Center"
                                                             Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="lastName"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="AccountDownload"
                                             materialDesign:HintAssist.Hint="Фамилия"
                                             materialDesign:HintAssist.Foreground="Black"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             CaretBrush="Black"
                                             SelectionBrush="Black"
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"                            
                                             Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationLastNameIcon"
                                                             Visibility="Hidden"
                                                             Width="15"
                                                             VerticalAlignment="Center"
                                                             Margin="0 0 0 5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <PasswordBox x:Name="dateOfBirth"
                                                 Style = "{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="PasswordAddOutline"
                                                 materialDesign:HintAssist.Hint="Повторите пароль"
                                                 materialDesign:HintAssist.Foreground="Black"
                                                 materialDesign:HintAssist.FontFamily="Arial"
                                                 materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                                 CaretBrush="Black"
                                                 SelectionBrush="Black"
                                                 Padding="5 5 5 5"
                                                 Margin="20 5 0 10"                            
                                                 Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationDateOfBirthIcon"
                                                             Visibility="Hidden"
                                                             Width="15"
                                                             VerticalAlignment="Center"
                                                             Margin="0 0 0 5"/>
                                </StackPanel>
                                <Border CornerRadius="5"
                                        BorderThickness="1"
                                        BorderBrush="#484a4a"                                       
                                        Width="215"
                                        Height="32"                                       
                                        Margin="5 0 0 5">
                                    <StackPanel Orientation="Horizontal"
                                                Width="250"
                                                HorizontalAlignment="Center">
                                    
                                    <RadioButton x:Name="maleRadio"
                                                  Content="Мужской"
                                                  GroupName="genderGroup"
                                                  Style="{StaticResource MaterialDesignRadioButton}"
                                                  Margin="20 5 0 5"
                                                  Padding="0 0 0 0"/>
                                    <RadioButton x:Name="femaleRadio"
                                                  Content="Женский"
                                                  GroupName="genderGroup"
                                                  Style="{StaticResource MaterialDesignRadioButton}"
                                                  Margin="20 5 0 5"
                                                  Padding="0 0 0 0"/>
                                    
                                </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            Width="250">
                                    <TextBox x:Name="role"
                                             Style = "{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                             materialDesign:HintAssist.Hint="Номер телефона"
                                             materialDesign:HintAssist.Foreground="Black"
                                             materialDesign:HintAssist.FontFamily="Arial"
                                             materialDesign:TextFieldAssist.UnderlineBrush="Black"                            
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.NewSpecHighlightingEnabled="False"
                                             CaretBrush="Black"
                                             SelectionBrush="Black"
                                             Padding="5 5 5 5"
                                             Margin="20 5 0 10"                            
                                             Width="215"/>
                                    <materialDesign:PackIcon x:Name="validationRoleIcon"
                                                             Visibility="Hidden"
                                                             Width="15"
                                                             VerticalAlignment="Center"
                                                             Margin="0 0 0 5"/>
                                </StackPanel>
                                <Button x:Name="btnCreate"
                                        Width="100"
                                        Height="40"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="15"
                                        BorderThickness="2"
                                        BorderBrush="#16596b"
                                        Background="#1d7d97"
                                        Foreground="#eaf0f3"
                                        ToolTip="Продолжить регистрацию"
                                        Click="btnNext_Click"
                                        Content="Далее"
                                        FontFamily="Roboto Medium"
                                        Margin="10"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
